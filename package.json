{
  "name": "pi-thread-phase-tools",
  "version": "0.12.0",
  "private": true,
  "description": "Thread-phase workflow visualizer and workflow examples for Pi.",
  "scripts": {
    "smoke": "node scripts/smoke-test.mjs",
    "test:dynamic": "node --test dynamic-thread-phase-workflow/test/*.test.mjs",
    "test": "npm run test:dynamic && node scripts/smoke-test.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "thread-phase"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "thread-phase-visualizer/index.ts",
      "codebase-exploration-workflow/index.ts",
      "code-review-workflow/index.ts",
      "dynamic-thread-phase-workflow/index.ts",
      "mission-workflow/index.ts"
    ],
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@autonome-research/thread-phase": "^4.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
